{
  "week": 10,
  "quests": {
    "w10q1": {
      "intro": "Unit 5's Word Study box: some plurals do not take an s at all.",
      "items": [
        { "id": "w10-01", "kind": "choice", "domain": "vocabulary", "level": 2,
          "prompt": "one child, two ______", "options": ["children", "childs", "childrens"], "answer": "children" },
        { "id": "w10-02", "kind": "choice", "domain": "vocabulary", "level": 2,
          "prompt": "one foot, two ______", "options": ["feet", "foots", "feets"], "answer": "feet" },
        { "id": "w10-03", "kind": "choice", "domain": "vocabulary", "level": 2,
          "prompt": "one tooth, two ______", "options": ["teeth", "tooths", "teeths"], "answer": "teeth" },
        { "id": "w10-04", "kind": "choice", "domain": "vocabulary", "level": 2,
          "prompt": "one mouse, two ______", "options": ["mice", "mouses", "mices"], "answer": "mice" },
        { "id": "w10-05", "kind": "choice", "domain": "vocabulary", "level": 2,
          "prompt": "one person, three ______", "options": ["people", "persons", "peoples"], "answer": "people" },
        { "id": "w10-06", "kind": "choice", "domain": "vocabulary", "level": 3,
          "prompt": "one sheep, ten ______", "options": ["sheep", "sheeps", "shept"], "answer": "sheep",
          "teach": "Some words simply do not change: sheep, fish, deer." },
        { "id": "w10-07", "kind": "choice", "domain": "vocabulary", "level": 3,
          "prompt": "one leaf, many ______", "options": ["leaves", "leafs", "leafes"], "answer": "leaves" },
        { "id": "w10-08", "kind": "choice", "domain": "vocabulary", "level": 3,
          "prompt": "one woman, two ______", "options": ["women", "womans", "womens"], "answer": "women" }
      ]
    },

    "w10q2": {
      "intro": "Unit 7's Word Study box: two words joined into one thing. You met these pages already, for their grammar — this is a different column.",
      "items": [
        { "id": "w10-09", "kind": "choice", "domain": "vocabulary", "level": 2,
          "prompt": "A ball you play with your foot is a ______.",
          "options": ["football", "ballfoot", "foot ball"], "answer": "football" },
        { "id": "w10-10", "kind": "choice", "domain": "vocabulary", "level": 2,
          "prompt": "A brush for your teeth is a ______.",
          "options": ["toothbrush", "teethbrush", "brushtooth"], "answer": "toothbrush",
          "teach": "Compounds keep the singular at the front: toothbrush, not teethbrush." },
        { "id": "w10-11", "kind": "choice", "domain": "vocabulary", "level": 2,
          "prompt": "A man made of snow is a ______.",
          "options": ["snowman", "mansnow", "snowyman"], "answer": "snowman" },
        { "id": "w10-12", "kind": "choice", "domain": "vocabulary", "level": 2,
          "prompt": "The bow of colours after the rain is a ______.",
          "options": ["rainbow", "bowrain", "rainybow"], "answer": "rainbow" },
        { "id": "w10-13", "kind": "choice", "domain": "vocabulary", "level": 3,
          "prompt": "A coat you wear in the rain is a ______.",
          "options": ["raincoat", "coatrain", "rainycoat"], "answer": "raincoat" },
        { "id": "w10-14", "kind": "choice", "domain": "vocabulary", "level": 3,
          "prompt": "The time when the sun goes down is ______.",
          "options": ["sunset", "setsun", "sundown"], "answer": "sunset" },
        { "id": "w10-15", "kind": "choice", "domain": "vocabulary", "level": 3,
          "prompt": "A room where you take a bath is a ______.",
          "options": ["bathroom", "roombath", "bathingroom"], "answer": "bathroom" },
        { "id": "w10-16", "kind": "choice", "domain": "vocabulary", "level": 3,
          "prompt": "Which of these is NOT a compound noun?",
          "options": ["beautiful", "playground", "bedroom", "homework"], "answer": "beautiful" }
      ]
    },

