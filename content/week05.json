  "quests": {
    "w05q1": {
      "intro": "Say each word out loud and clap the beats. Cam-e-ra is three claps, even though it sounds like two when you say it fast.",
      "items": [
        { "id": "w05-01", "kind": "choice", "domain": "spelling", "level": 2, "say": "camera",
          "prompt": "How many beats in camera?", "options": ["3", "2", "4"], "answer": "3", "shuffle": false,
          "teach": "cam - e - ra. Say it slowly like a robot and the quiet beat comes back." },
        { "id": "w05-02", "kind": "choice", "domain": "spelling", "level": 2, "say": "family",
          "prompt": "How many beats in family?", "options": ["3", "2", "4"], "answer": "3", "shuffle": false },
        { "id": "w05-03", "kind": "choice", "domain": "spelling", "level": 2, "say": "chocolate",
          "prompt": "How many beats in chocolate?", "options": ["3", "2", "4"], "answer": "3", "shuffle": false,
          "teach": "choc - o - late. Almost everybody says it in two, and it is written in three." },
        { "id": "w05-04", "kind": "choice", "domain": "spelling", "level": 2, "say": "different",
          "prompt": "How many beats in different?", "options": ["3", "2", "4"], "answer": "3", "shuffle": false },
        { "id": "w05-05", "kind": "choice", "domain": "spelling", "level": 2, "say": "every",
          "prompt": "How many beats in every?", "options": ["3", "2", "1"], "answer": "3", "shuffle": false,
          "teach": "ev - er - y. You almost certainly say it in two. Write it in three." },
        { "id": "w05-06", "kind": "choice", "domain": "spelling", "level": 3, "say": "vegetable",
          "prompt": "How many beats in vegetable?", "options": ["4", "3", "2"], "answer": "4", "shuffle": false },
        { "id": "w05-07", "kind": "choice", "domain": "spelling", "level": 3, "say": "favourite",
          "prompt": "How many beats in favourite?", "options": ["3", "2", "4"], "answer": "3", "shuffle": false },
        { "id": "w05-08", "kind": "choice", "domain": "spelling", "level": 3, "say": "elephant",
          "prompt": "How many beats in elephant?", "options": ["3", "2", "4"], "answer": "3", "shuffle": false }
      ]
    },

    "w05q2": {
      "intro": "In each of these words one vowel has gone quiet. Find it — and remember it is still written down.",
      "items": [
        { "id": "w05-09", "kind": "choice", "domain": "spelling", "level": 2,
          "prompt": "cam _ ra — which letter is hiding?", "options": ["e", "o", "a", "u"], "answer": "e" },
        { "id": "w05-10", "kind": "choice", "domain": "spelling", "level": 2,
          "prompt": "fam _ ly — which letter is hiding?", "options": ["i", "e", "o", "a"], "answer": "i" },
        { "id": "w05-11", "kind": "choice", "domain": "spelling", "level": 2,
          "prompt": "choc _ late — which letter is hiding?", "options": ["o", "a", "e", "u"], "answer": "o" },
        { "id": "w05-12", "kind": "choice", "domain": "spelling", "level": 2,
          "prompt": "diff _ rent — which letter is hiding?", "options": ["e", "a", "i", "o"], "answer": "e" },
        { "id": "w05-13", "kind": "choice", "domain": "spelling", "level": 2,
          "prompt": "ev _ ry — which letter is hiding?", "options": ["e", "a", "i", "o"], "answer": "e" },
        { "id": "w05-14", "kind": "choice", "domain": "spelling", "level": 3,
          "prompt": "veg _ table — which letter is hiding?", "options": ["e", "i", "a", "o"], "answer": "e" },
        { "id": "w05-15", "kind": "choice", "domain": "spelling", "level": 3,
          "prompt": "fav _ urite — which letter is hiding?", "options": ["o", "e", "a", "i"], "answer": "o" },
        { "id": "w05-16", "kind": "choice", "domain": "spelling", "level": 3,
          "prompt": "int _ resting — which letter is hiding?", "options": ["e", "a", "i", "o"], "answer": "e" },
        { "id": "w05-17", "kind": "choice", "domain": "spelling", "level": 3,
          "prompt": "Which one of these has NO quiet middle vowel?",
          "options": ["rabbit", "camera", "family", "chocolate"], "answer": "rabbit",
          "teach": "Rab-bit: you hear both beats clearly. That is why it is easy to spell." }
      ]
    },

