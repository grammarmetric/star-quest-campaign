{
  "week": 6,
  "flag": "below her level",
  "quests": {
    "w06q1": {
      "intro": "Twenty pairs. Each one is a single step: “not X” means “Y”. That step is the whole of this week.",
      "items": [
        { "id": "w06-01", "kind": "choice", "domain": "vocabulary", "level": 1,
          "prompt": "not open  =", "options": ["closed", "big", "new"], "answer": "closed",
          "teach": "This is the step. Not open does not mean “a door”. It means closed." },
        { "id": "w06-02", "kind": "choice", "domain": "vocabulary", "level": 1,
          "prompt": "not hot  =", "options": ["cold", "wet", "loud"], "answer": "cold" },
        { "id": "w06-03", "kind": "choice", "domain": "vocabulary", "level": 1,
          "prompt": "not big  =", "options": ["small", "old", "fast"], "answer": "small" },
        { "id": "w06-04", "kind": "choice", "domain": "vocabulary", "level": 1,
          "prompt": "not old  =", "options": ["new", "tall", "quiet"], "answer": "new" },
        { "id": "w06-05", "kind": "choice", "domain": "vocabulary", "level": 1,
          "prompt": "not loud  =", "options": ["quiet", "empty", "dirty"], "answer": "quiet" },
        { "id": "w06-06", "kind": "choice", "domain": "vocabulary", "level": 1,
          "prompt": "not full  =", "options": ["empty", "short", "slow"], "answer": "empty" },
        { "id": "w06-07", "kind": "choice", "domain": "vocabulary", "level": 1,
          "prompt": "not clean  =", "options": ["dirty", "happy", "long"], "answer": "dirty" },
        { "id": "w06-08", "kind": "choice", "domain": "vocabulary", "level": 1,
          "prompt": "not fast  =", "options": ["slow", "wet", "light"], "answer": "slow" },
        { "id": "w06-09", "kind": "choice", "domain": "vocabulary", "level": 2,
          "prompt": "not allowed  =", "options": ["forbidden", "expensive", "closed"], "answer": "forbidden",
          "teach": "Not allowed and forbidden say the same thing. Signs prefer the short one." },
        { "id": "w06-10", "kind": "choice", "domain": "vocabulary", "level": 2,
          "prompt": "not working  =", "options": ["broken", "busy", "free"], "answer": "broken" },
        { "id": "w06-11", "kind": "choice", "domain": "vocabulary", "level": 2,
          "prompt": "not right  =", "options": ["wrong", "left", "late"], "answer": "wrong",
          "teach": "Careful — right has two opposites. Not right (correct) is wrong; the other right is the opposite of left." },
        { "id": "w06-12", "kind": "choice", "domain": "vocabulary", "level": 2,
          "prompt": "not early  =", "options": ["late", "slow", "soon"], "answer": "late" },
        { "id": "w06-13", "kind": "choice", "domain": "vocabulary", "level": 2,
          "prompt": "not safe  =", "options": ["dangerous", "difficult", "closed"], "answer": "dangerous" },
        { "id": "w06-14", "kind": "choice", "domain": "vocabulary", "level": 2,
          "prompt": "not cheap  =", "options": ["expensive", "heavy", "empty"], "answer": "expensive" },
        { "id": "w06-15", "kind": "choice", "domain": "vocabulary", "level": 2,
          "prompt": "not easy  =", "options": ["difficult", "boring", "quiet"], "answer": "difficult" },
        { "id": "w06-16", "kind": "choice", "domain": "vocabulary", "level": 2,
          "prompt": "not free  =", "options": ["you must pay", "busy", "open"], "answer": "you must pay" },
        { "id": "w06-17", "kind": "choice", "domain": "vocabulary", "level": 2,
          "prompt": "not here  =", "options": ["away", "near", "inside"], "answer": "away" },
        { "id": "w06-18", "kind": "choice", "domain": "vocabulary", "level": 3,
          "prompt": "not the same  =", "options": ["different", "difficult", "wrong"], "answer": "different" },
        { "id": "w06-19", "kind": "choice", "domain": "vocabulary", "level": 3,
          "prompt": "not possible  =", "options": ["impossible", "important", "unhappy"], "answer": "impossible",
          "teach": "English often makes the opposite by adding im- or un- to the front." },
        { "id": "w06-20", "kind": "choice", "domain": "vocabulary", "level": 3,
          "prompt": "not tidy  =", "options": ["untidy", "unhappy", "unwell"], "answer": "untidy" }
      ]
    },

    "w06q2": {
      "intro": "This is the exact item from the test on 20 August, with nothing softened. Read the sentence, then read all three signs before you choose.",
      "items": [
        { "id": "w06-21", "kind": "choice", "domain": "reading", "level": 1,
          "prompt": "The shop is not open now.",
          "subprompt": "Which sign says the same thing?",
          "options": ["CLOSED", "OPEN — COME IN!", "PUSH THE DOOR"], "answer": "CLOSED",
          "teach": "PUSH THE DOOR belongs to a shop and a door — the right situation, the wrong meaning. Not open means CLOSED, one step." },
        { "id": "w06-22", "kind": "choice", "domain": "reading", "level": 1,
          "prompt": "You cannot come in here.",
          "options": ["NO ENTRY", "WELCOME", "OPEN 9-5"], "answer": "NO ENTRY" },
        { "id": "w06-23", "kind": "choice", "domain": "reading", "level": 2,
          "prompt": "The lift is not working today.",
          "options": ["OUT OF ORDER", "LIFT TO ALL FLOORS", "PLEASE WAIT HERE"], "answer": "OUT OF ORDER",
          "teach": "Again the trap repeats a word from the sentence. LIFT is in both — and it is not the answer." },
        { "id": "w06-24", "kind": "choice", "domain": "reading", "level": 2,
          "prompt": "You do not have to pay to go in.",
          "options": ["FREE ENTRY", "TICKETS £5", "PAY HERE"], "answer": "FREE ENTRY" },
        { "id": "w06-25", "kind": "choice", "domain": "reading", "level": 2,
          "prompt": "There is no more bread today.",
          "options": ["SOLD OUT", "FRESH BREAD", "BAKERY OPEN"], "answer": "SOLD OUT" },
        { "id": "w06-26", "kind": "choice", "domain": "reading", "level": 2,
          "prompt": "This water is not safe to drink.",
          "options": ["DO NOT DRINK", "DRINKING WATER", "WATER THIS WAY"], "answer": "DO NOT DRINK" }
      ]
    },

    "w06q3": {
      "intro": "Careful now. In each one, a wrong answer repeats a word from the sentence. The right answer usually does not.",
      "items": [
        { "id": "w06-27", "kind": "choice", "domain": "reading", "level": 2,
          "prompt": "The swimming pool is closed on Mondays.",
          "subprompt": "Which is true?",
          "options": ["You cannot swim on Monday.", "The pool opens on Monday.", "You can swim every day."],
          "answer": "You cannot swim on Monday." },
        { "id": "w06-28", "kind": "choice", "domain": "reading", "level": 2,
          "prompt": "Dogs are not allowed in the park.",
          "options": ["NO DOGS", "DOGS WELCOME", "PARK THIS WAY"], "answer": "NO DOGS",
          "teach": "You got this pattern right in the test. It is the same step as the shop — just easier to see." },
        { "id": "w06-29", "kind": "choice", "domain": "reading", "level": 3,
          "prompt": "The museum is open every day except Sunday.",
          "options": ["It is closed on Sunday.", "It is only open on Sunday.", "It is closed every day."],
          "answer": "It is closed on Sunday.",
          "teach": "Except flips just one day out of the sentence, and leaves the rest alone." },
        { "id": "w06-30", "kind": "choice", "domain": "reading", "level": 3,
          "prompt": "This seat is not free.",
          "options": ["Somebody is sitting here.", "This seat costs nothing.", "Sit down here."],
          "answer": "Somebody is sitting here." },
        { "id": "w06-31", "kind": "choice", "domain": "reading", "level": 3,
          "prompt": "You must not take photographs in here.",
          "options": ["NO CAMERAS", "CAMERAS FOR SALE", "PHOTOGRAPHS THIS WAY"], "answer": "NO CAMERAS",
          "teach": "The word you spent two minutes on in the test turns up here as a sign. Same word, different job." },
        { "id": "w06-32", "kind": "choice", "domain": "reading", "level": 3,
          "prompt": "The train does not stop at this station.",
          "options": ["The train goes past without stopping.", "The train stops here.", "There is no train today."],
          "answer": "The train goes past without stopping." }
      ]
    }
  }
}
